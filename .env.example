# LLM providers (optional; without them Rivyu uses its offline fallback).
GEMINI_API_KEY=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Reddit API app credentials (required for the Reddit source).
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional
# CORS_ORIGINS=https://example.com
# ENABLE_EXPERIMENTAL_SOURCES=false
PORT=8000
